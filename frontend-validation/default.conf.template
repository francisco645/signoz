# Read-only proxy: the frontend can query the running SigNoz but cannot change it.
# Reads (GET/HEAD/OPTIONS) and the POST endpoints that only run queries pass;
# every other POST/PUT/PATCH/DELETE is answered 403 here and never reaches SigNoz.
# Login and session refresh create session rows, so they are blocked unless
# ALLOW_LOGIN=1.
map "$request_method:$uri" $read_only_allowed {
    default 0;
    "~^(GET|HEAD|OPTIONS):" 1;
    "~^POST:/api/v[0-9]+/query_range$" 1;
    "~^POST:/api/v1/dependency_graph$" 1;
    "~^POST:/api/v2/services$" 1;
    "~^POST:/api/v1/authz/check$" 1;
    "~^POST:/api/v1/service/top_level_operations$" 1;
    "~^POST:/api/v1/variables/query$" 1;
    "~^POST:/api/v1/(listErrors|countErrors|span_percentile)$" 1;
    "~^POST:/api/v1/traces/[^/]+/aggregations$" 1;
    "~^POST:/api/v3/traces/[^/]+/flamegraph$" 1;
    "~^POST:/api/v4/traces/[^/]+/waterfall$" 1;
    "~^POST:/api/v2/sessions/(email_password|rotate)$" ${ALLOW_LOGIN};
}

log_format validation '$time_local $request_method $uri $status allowed=$read_only_allowed';

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    access_log /var/log/nginx/access.log validation;

    location /api/ {
        if ($read_only_allowed = 0) {
            add_header Content-Type application/json always;
            return 403 '{"status":"error","error":"blocked by the read-only validation proxy"}';
        }
        proxy_pass ${SIGNOZ_BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /ws {
        if ($request_method != GET) {
            return 403;
        }
        proxy_pass ${SIGNOZ_BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }

    location /assets/ {
        expires 7d;
        try_files $uri =404;
    }

    # Client-side routes fall back to the app shell.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
